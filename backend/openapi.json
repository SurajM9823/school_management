components:
  schemas:
    AcademicSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 20
        status:
          $ref: '#/components/schemas/AcademicSessionStatusEnum'
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
      required:
      - end_date
      - id
      - name
      - start_date
      - status
    AcademicSessionRequest:
      type: object
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 20
        status:
          $ref: '#/components/schemas/AcademicSessionStatusEnum'
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
        school_id:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - end_date
